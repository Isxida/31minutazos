---
// "Mi entrada en 3D": recuerdo fan (sin validez). Pregunta fecha y zona, y arma un ticket CSS 3D que se gira.
import { Image } from 'astro:assets';
import logo from '../assets/logo31.png';
import titeres from '../assets/titeres.png';
import { evento } from '../data/evento';

const fechas = [...evento.fechasAgotadas, evento.fechaPrincipal].sort();
const ORDEN = ['Primera', 'Segunda', 'Tercera', 'Cuarta'];
// Aspecto de cada zona en el mapa, en el mismo orden que evento.zonas.
const VIS = [
  { r: [62, 118], bg: '#fffde0', ink: '#231f20', fs: 24 },
  { r: [126, 172], bg: '#f5c623', ink: '#a51722', fs: 26 },
  { r: [180, 236], bg: '#a51722', ink: '#fffde0', fs: 28 },
  { r: [244, 266], bg: '#8fada0', ink: '#231f20', fs: 14 },
];
const C = [200, 20], A1 = 42, A2 = 138;
const pt = (r: number, a: number) =>
  `${(C[0] + r * Math.cos((a * Math.PI) / 180)).toFixed(1)} ${(C[1] + r * Math.sin((a * Math.PI) / 180)).toFixed(1)}`;
const sector = ([r1, r2]: number[]) =>
  `M${pt(r1, A1)}A${r1} ${r1} 0 0 1 ${pt(r1, A2)}L${pt(r2, A2)}A${r2} ${r2} 0 0 0 ${pt(r2, A1)}Z`;
---
<dialog id="e3" class="e3" aria-labelledby="e3-titulo">
  <header class="e3-head">
    <h2 id="e3-titulo">¿Qué día vas?</h2>
    <button class="e3-x" type="button" data-cerrar aria-label="Cerrar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg>
    </button>
  </header>

  <section data-paso="1" class="e3-fechas">
    {fechas.map((f, i) => (
      <button type="button" class="e3-fecha" data-fecha={f} data-orden={`${ORDEN[i]} fecha`}>
        <b>{f.split(' ')[0]}</b><span>{f.split(' ').slice(1).join(' ')}</span><small>{ORDEN[i]} fecha</small>
      </button>
    ))}
  </section>

  <section data-paso="2" hidden>
    <svg class="e3-mapa" viewBox="0 0 400 290" role="group" aria-label="Mapa referencial de zonas">
      <g fill="#231f20" aria-hidden="true">
        <rect x="100" y="16" width="52" height="46"/><rect x="248" y="16" width="52" height="46"/>
        <path d="M152 16l48-14 48 14v46h-96z"/>
      </g>
      <rect x="182" y="38" width="36" height="24" fill="#ff5a1f" aria-hidden="true"/>
      {evento.zonas.map((z, i) => (
        <g class="e3-zona" role="button" tabindex="0" data-zona={z} aria-label={`Zona ${z}`}>
          <path d={sector(VIS[i].r)} fill={VIS[i].bg}/>
          <text x="200" y={C[1] + (VIS[i].r[0] + VIS[i].r[1]) / 2 + VIS[i].fs * 0.36} font-size={VIS[i].fs} fill={VIS[i].ink} text-anchor="middle">{z}</text>
        </g>
      ))}
    </svg>
    <p class="e3-nota">Mapa referencial. Toca tu zona.</p>
  </section>

  <section data-paso="3" hidden>
    <div class="e3-stage">
      <div class="e3-scene" id="e3-scene" tabindex="0" role="img" aria-label="Tu entrada en 3D. Arrastra o toca para girarla.">
        <div class="e3-ticket" id="e3-ticket">
          <div class="e3-face">
            <div class="e3-main e3-front-main">
              <Image class="e3-logo" src={logo} alt="" width={120} height={120} loading="lazy" />
              <p class="e3-title">{evento.titulo.map((l) => <span>{l}</span>)}</p>
              <span class="e3-tour">{evento.etiqueta}</span>
              <span class="e3-orden" data-f="orden"></span>
              <Image class="e3-titeres" src={titeres} alt="" width={480} loading="lazy" />
              <i class="e3-holo"></i>
            </div>
            <div class="e3-stub e3-front-stub">
              <p class="e3-zona-txt">Zona <span data-f="zona"></span></p>
              <p class="e3-ciudad">{evento.ciudad}</p>
              <p class="e3-lugar">{evento.lugar}</p>
              <p class="e3-dia" data-f="fecha"></p>
              <p class="e3-hora">{evento.hora}</p>
              <div class="e3-barras" id="e3-barras" aria-hidden="true"></div>
              <p class="e3-legal">Recuerdo fan · sin validez de ingreso</p>
              <i class="e3-holo"></i>
            </div>
          </div>
          <div class="e3-face e3-back">
            <div class="e3-main e3-back-main">
              <span class="e3-setlist-tag">Setlist:</span>
              <ol class="e3-setlist">{evento.setlist.map((c) => <li>{c}</li>)}</ol>
              <i class="e3-holo"></i>
            </div>
            <div class="e3-stub e3-back-stub">
              <Image class="e3-logo-back" src={logo} alt="31 Minutos" width={150} height={150} loading="lazy" />
              <p class="e3-club">{evento.fanclub}</p>
              <i class="e3-holo"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    <p class="e3-nota">Arrastra o toca la entrada para girarla. Es un recuerdo de fans, no una entrada válida.</p>
    <div class="e3-acciones">
      <button type="button" class="e3-btn" id="e3-girar">Girar</button>
      <button type="button" class="e3-btn" id="e3-descargar">Descargar PNG</button>
      <button type="button" class="e3-btn e3-btn-sec" id="e3-cambiar">Cambiar datos</button>
    </div>
  </section>
</dialog>

<script>
  const dlg = document.getElementById('e3') as HTMLDialogElement;
  const titulo = document.getElementById('e3-titulo')!;
  const scene = document.getElementById('e3-scene')!;
  const ticket = document.getElementById('e3-ticket')!;
  const pasos = [...dlg.querySelectorAll<HTMLElement>('[data-paso]')];
  const TITULOS = ['¿Qué día vas?', '¿Cuál es tu zona?', 'Tu entrada en 3D'];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const dato = { fecha: '', orden: '', zona: '' };
  const leer = (sel: string) => dlg.querySelector(sel)!.textContent!.trim().toUpperCase();
  const TEXTO_TOUR = leer('.e3-tour'), TEXTO_CIUDAD = leer('.e3-ciudad'), TEXTO_LUGAR = leer('.e3-lugar'), TEXTO_HORA = leer('.e3-hora');
  let paso = 1;

  function ir(n: number) {
    paso = n;
    pasos.forEach((p) => (p.hidden = p.dataset.paso !== String(n)));
    titulo.textContent = TITULOS[n - 1];
    if (n === 3) { base = 0; rx = -6; ry = -18; kick(); }
  }

  // Barras decorativas derivadas de fecha + zona; no es un código real.
  function barras(texto: string) {
    let h = 2166136261;
    for (const c of texto) h = Math.imul(h ^ c.codePointAt(0)!, 16777619) >>> 0;
    const out: number[] = [];
    for (let i = 0; i < 56; i++) { h = Math.imul(h ^ (h >>> 15), 2246822519) >>> 0; out.push(1 + (h % 3)); }
    return out;
  }
  function pintar() {
    dlg.querySelectorAll<HTMLElement>('[data-f]').forEach((el) => (el.textContent = dato[el.dataset.f as keyof typeof dato]));
    document.getElementById('e3-barras')!.replaceChildren(...barras(dato.fecha + dato.zona).map((w) => {
      const b = document.createElement('span'); b.style.flexGrow = String(w); return b;
    }));
  }

  document.getElementById('abrir-entrada')!.addEventListener('click', () => { ir(1); dlg.showModal(); });
  dlg.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-cerrar]')) return dlg.close();
    const f = t.closest<HTMLElement>('.e3-fecha');
    if (f) { dato.fecha = f.dataset.fecha!; dato.orden = f.dataset.orden!; return ir(2); }
    const z = t.closest<HTMLElement>('.e3-zona');
    if (z) { dato.zona = z.dataset.zona!; pintar(); ir(3); }
  });
  dlg.addEventListener('keydown', (e) => {
    const z = (e.target as HTMLElement).closest<HTMLElement>('.e3-zona');
    if (z && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); z.dispatchEvent(new MouseEvent('click', { bubbles: true })); }
  });
  document.getElementById('e3-cambiar')!.addEventListener('click', () => ir(1));

  // Giro: vaivén en reposo, arrastre con inercia que cae en la cara más cercana, y toque para voltear.
  let base = 0, rx = -6, ry = -18, raf = 0, last = 0;
  let drag: null | { id: number; x: number; y: number; rx: number; ry: number; lastX: number; lastT: number; v: number; moved: boolean } = null;
  function apply() {
    const s = Math.sin((ry * Math.PI) / 180);
    ticket.style.setProperty('--rx', `${rx.toFixed(2)}deg`);
    ticket.style.setProperty('--ry', `${ry.toFixed(2)}deg`);
    ticket.style.setProperty('--tilt', s.toFixed(3));
    ticket.style.setProperty('--shine', Math.abs(s).toFixed(3));
  }
  function frame(now: number) {
    if (!dlg.open || paso !== 3) { raf = 0; last = 0; return; }
    const dt = Math.min(64, last ? now - last : 16);
    last = now;
    if (!drag) {
      const still = reduce.matches;
      const tx = still ? -5 : -6 + Math.sin(now / 2300) * 5;
      const ty = still ? base - 16 : base + Math.sin(now / 1500) * 24;
      const k = 1 - Math.exp(-dt / 140);
      rx += (tx - rx) * k; ry += (ty - ry) * k;
      if (still && Math.abs(tx - rx) + Math.abs(ty - ry) < 0.05) { apply(); raf = 0; last = 0; return; }
    }
    apply();
    raf = requestAnimationFrame(frame);
  }
  function kick() { if (!raf) raf = requestAnimationFrame(frame); }
  function flip(d = 1) { base += 180 * d; kick(); }

  scene.addEventListener('pointerdown', (e) => {
    if (e.button !== 0) return;
    drag = { id: e.pointerId, x: e.clientX, y: e.clientY, rx, ry, lastX: e.clientX, lastT: e.timeStamp, v: 0, moved: false };
    scene.setPointerCapture(e.pointerId);
    kick();
  });
  scene.addEventListener('pointermove', (e) => {
    if (!drag || e.pointerId !== drag.id) return;
    const dx = e.clientX - drag.x, dy = e.clientY - drag.y;
    if (Math.abs(dx) + Math.abs(dy) > 5) drag.moved = true;
    ry = drag.ry + dx * 0.5;
    rx = Math.max(-40, Math.min(40, drag.rx - dy * 0.3));
    const dt = e.timeStamp - drag.lastT;
    if (dt > 0) drag.v = ((e.clientX - drag.lastX) * 0.5) / dt;
    drag.lastX = e.clientX; drag.lastT = e.timeStamp;
  });
  function soltar(e: PointerEvent) {
    if (!drag || e.pointerId !== drag.id) return;
    const { moved, v } = drag;
    drag = null;
    if (moved) base = Math.round((ry + Math.max(-180, Math.min(180, v * 160))) / 180) * 180;
    else if (e.type === 'pointerup') base += 180;
    kick();
  }
  scene.addEventListener('pointerup', soltar);
  scene.addEventListener('pointercancel', soltar);
  scene.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ' || e.key === 'ArrowRight') flip(1);
    else if (e.key === 'ArrowLeft') flip(-1);
    else return;
    e.preventDefault();
  });
  document.getElementById('e3-girar')!.addEventListener('click', () => flip(1));

  // Descarga: se dibuja el frente en un canvas (sin brillos ni destellos) a 40 px por "em" de la entrada.
  const cargar = (src: string) => new Promise<HTMLImageElement>((ok, mal) => {
    const i = new Image(); i.onload = () => ok(i); i.onerror = mal; i.src = src;
  });
  function partir(c: CanvasRenderingContext2D, texto: string, ancho: number) {
    const lineas: string[] = []; let l = '';
    for (const w of texto.split(' ')) {
      if (l && c.measureText(l + ' ' + w).width > ancho) { lineas.push(l); l = w; } else l = l ? l + ' ' + w : w;
    }
    return l ? [...lineas, l] : lineas;
  }
  async function descargar() {
    const U = 40, W = 52 * U, H = 22 * U;
    await Promise.all(["40px Anton", "40px 'Alfa Slab One'"].map((f) => document.fonts.load(f)));
    const logoEl = dlg.querySelector<HTMLImageElement>('.e3-front-main .e3-logo')!;
    const monosEl = dlg.querySelector<HTMLImageElement>('.e3-titeres')!;
    const [logo, titeres] = await Promise.all([cargar(logoEl.currentSrc || logoEl.src), cargar(monosEl.currentSrc || monosEl.src)]);

    const cv = document.createElement('canvas'); cv.width = W; cv.height = H;
    const c = cv.getContext('2d')!;
    c.textAlign = 'center'; c.textBaseline = 'middle';
    // forma de la entrada
    c.beginPath(); c.roundRect(0, 0, W, H, 1.1 * U); c.clip();
    // fondo del cuerpo y del talón
    c.fillStyle = '#f7a31c'; c.fillRect(0, 0, W, H);
    c.fillStyle = '#ef5a3a'; c.fillRect(0, 0, 38 * U, 9.6 * U);
    // rayitas de la franja
    c.fillStyle = 'rgba(255,251,230,.7)';
    for (let x = 0; x < 38 * U; x += .34 * U) { c.fillRect(x, 2.2 * U, .12 * U, .4 * U); c.fillRect(x, 7.8 * U, .12 * U, .4 * U); }
    // logo
    c.save(); c.shadowColor = 'rgba(0,0,0,.25)'; c.shadowBlur = .5 * U; c.shadowOffsetY = .2 * U;
    c.beginPath(); c.arc(4.6 * U, 4.2 * U, 3 * U, 0, Math.PI * 2); c.fillStyle = '#fff'; c.fill(); c.restore();
    c.save(); c.beginPath(); c.arc(4.6 * U, 4.2 * U, 3 * U, 0, Math.PI * 2); c.clip(); c.drawImage(logo, 1.6 * U, 1.2 * U, 6 * U, 6 * U); c.restore();
    // título
    c.fillStyle = '#231f20'; c.font = `${4.2 * U}px Anton`;
    ['RADIO', 'GUARIPOLO'].forEach((t, i) => c.fillText(t, 23 * U, (0.9 + 3.864 * (i + 0.5)) * U));
    // títeres (centrados en el cuerpo, asomando por abajo)
    const th = 11.4 * U, tw = th * (titeres.naturalWidth / titeres.naturalHeight);
    c.drawImage(titeres, 19 * U - tw / 2, 22.6 * U - th, tw, th);
    // etiquetas inclinadas
    const etiqueta = (texto: string, fuente: string, tam: number, color: string, derecha: number, arriba: number) => {
      c.font = `${tam * U}px ${fuente}`;
      const w = c.measureText(texto).width + tam * 1.5 * U, h = tam * 1.5 * U;
      const x = (38 - derecha) * U - w, y = arriba * U;
      c.save(); c.translate(x + w / 2, y + h / 2); c.rotate(-3 * Math.PI / 180);
      c.fillStyle = '#fffbe6'; c.beginPath(); c.roundRect(-w / 2, -h / 2, w, h, .3 * tam * U); c.fill();
      c.fillStyle = color; c.fillText(texto, 0, 0); c.restore();
    };
    etiqueta(TEXTO_TOUR, "'Alfa Slab One'", 1.25, '#ef4a2a', 2.3, 7.9);
    etiqueta(dato.orden.toUpperCase(), 'Anton', 1.3, '#231f20', 2.3, 9.25);

    // talón
    const cx = 45 * U, ancho = 11.8 * U;
    let y = 1.5;
    const linea = (texto: string, fuente: string, tam: number, lh: number, color: string, antes: number) => {
      y += antes; c.font = `${tam * U}px ${fuente}`; c.fillStyle = color;
      for (const t of partir(c, texto, ancho)) { c.fillText(t, cx, (y + lh * tam / 2) * U); y += lh * tam; }
    };
    linea('ZONA ' + dato.zona.toUpperCase(), "'Alfa Slab One'", 1.15, 1.15, '#c2001a', 0);
    linea(TEXTO_CIUDAD, 'Anton', 2, 1, '#231f20', .5);
    linea(TEXTO_LUGAR, 'Anton', .98, 1.15, '#231f20', .5);
    linea(dato.fecha.toUpperCase(), 'Anton', 1.35, 1, '#c2001a', .7);
    linea(TEXTO_HORA, 'Anton', 1.4, 1, '#231f20', .4);
    // barras decorativas y leyenda
    const bs = barras(dato.fecha + dato.zona), total = bs.reduce((a, b) => a + b, 0);
    let bx = 39.1 * U;
    bs.forEach((w, i) => { const bw = (w / total) * ancho; if (i % 2 === 0) { c.fillStyle = '#231f20'; c.fillRect(bx, 17.2 * U, bw, 2.6 * U); } bx += bw; });
    c.font = `700 ${.5 * U}px system-ui, sans-serif`; c.fillStyle = '#231f20';
    if ('letterSpacing' in c) (c as any).letterSpacing = `${.03 * U}px`;
    c.fillText('RECUERDO FAN · SIN VALIDEZ DE INGRESO', cx, 20.55 * U);
    if ('letterSpacing' in c) (c as any).letterSpacing = '0px';
    // línea de corte
    c.strokeStyle = 'rgba(35,31,32,.5)'; c.lineWidth = .12 * U; c.setLineDash([.33 * U, .27 * U]);
    c.beginPath(); c.moveTo(38 * U, .9 * U); c.lineTo(38 * U, 21.1 * U); c.stroke(); c.setLineDash([]);
    // muescas
    c.globalCompositeOperation = 'destination-out';
    for (const oy of [0, 22]) { c.beginPath(); c.arc(38 * U, oy * U, .8 * U, 0, Math.PI * 2); c.fill(); }

    cv.toBlob((b) => {
      if (!b) return;
      const a = document.createElement('a');
      const slug = (t: string) => t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-');
      a.href = URL.createObjectURL(b); a.download = `entrada-31minutazos-${slug(dato.fecha)}-${slug(dato.zona)}.png`;
      a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    }, 'image/png');
  }
  document.getElementById('e3-descargar')!.addEventListener('click', descargar);

</script>

<style is:global>
  .e3 { width: min(920px, calc(100% - 16px)); max-height: 96dvh; margin: auto; padding: 16px; border: 0; border-radius: 20px;
    background: #231f20; color: #fffbe6; font-family: 'Anton', sans-serif; box-shadow: 0 24px 60px rgba(0,0,0,.5); }
  .e3::backdrop { background: rgba(35,31,32,.78); }
  .e3 [hidden] { display: none !important; }
  .e3-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .e3-head h2 { font-weight: 400; font-size: clamp(1.6rem, 6vw, 2.4rem); line-height: 1; text-transform: uppercase; }
  .e3-x { flex: none; width: 44px; height: 44px; padding: 12px; border: 0; border-radius: 50%; background: #fffbe6; color: #231f20; cursor: pointer; }
  .e3-x svg { display: block; width: 100%; height: 100%; }
  .e3 :focus-visible { outline: 3px solid #ffc800; outline-offset: 3px; }

  .e3-fechas { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
  @media (min-width: 700px) { .e3-fechas { grid-template-columns: repeat(4, 1fr); } }
  .e3-fecha { display: grid; gap: 2px; padding: 16px 8px; border: 0; border-radius: 14px; background: #ffc800; color: #231f20; cursor: pointer;
    font: inherit; text-transform: uppercase; transition: transform .15s, background-color .15s; }
  .e3-fecha:hover, .e3-fecha:focus-visible { transform: translateY(-4px) rotate(-1.5deg); background: #fffbe6; }
  .e3-fecha b { font-weight: 400; font-size: clamp(3rem, 13vw, 4.5rem); line-height: .95; color: #c2001a; }
  .e3-fecha span { font-size: 1.1rem; }
  .e3-fecha small { font-family: 'Alfa Slab One', serif; font-size: .78rem; color: #5a3a00; }

  .e3-mapa { display: block; width: min(100%, 560px); margin: 0 auto; padding: 14px; border-radius: 16px; background: #ff5a1f; }
  .e3-zona { cursor: pointer; outline-offset: 2px; }
  .e3-zona path { transition: transform .15s; transform-origin: 200px 20px; }
  .e3-zona text { font-family: 'Anton', sans-serif; text-transform: uppercase; pointer-events: none; }
  .e3-zona:hover path, .e3-zona:focus-visible path { transform: scale(1.03); }
  .e3-nota { margin-top: 10px; text-align: center; font-family: system-ui, sans-serif; font-size: .9rem; color: #e9dfc4; }

  .e3-stage { container-type: inline-size; border-radius: 16px; background: radial-gradient(60% 70% at 50% 45%, #5b2a12, #231f20 75%); }
  .e3-scene { display: grid; place-items: center; min-height: 31em; font-size: clamp(4px, (100cqi - 12px) / 56, 15px); perspective: 95em;
    touch-action: none; cursor: grab; user-select: none; -webkit-user-select: none; border-radius: 16px; }
  .e3-scene:active { cursor: grabbing; }
  .e3-ticket { --notch-r: radial-gradient(circle at 100% 0, #0000 .8em, #000 calc(.8em + .5px)) 0 0/100% 51% no-repeat, radial-gradient(circle at 100% 100%, #0000 .8em, #000 calc(.8em + .5px)) 0 100%/100% 51% no-repeat;
    --notch-l: radial-gradient(circle at 0 0, #0000 .8em, #000 calc(.8em + .5px)) 0 0/100% 51% no-repeat, radial-gradient(circle at 0 100%, #0000 .8em, #000 calc(.8em + .5px)) 0 100%/100% 51% no-repeat;
    position: relative; width: 52em; height: 22em; color: #231f20; line-height: 1; text-transform: uppercase;
    transform-style: preserve-3d; transform: rotateX(var(--rx, -6deg)) rotateY(var(--ry, -18deg)); }
  .e3-face { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .e3-back { transform: rotateY(180deg); }
  .e3-main, .e3-stub { position: absolute; top: 0; bottom: 0; overflow: hidden; background: #f7a31c; }
  .e3-main { left: 0; width: 38em; border-radius: 1.1em 0 0 1.1em; -webkit-mask: var(--notch-r); mask: var(--notch-r); }
  .e3-stub { right: 0; width: 14em; border-radius: 0 1.1em 1.1em 0; -webkit-mask: var(--notch-l); mask: var(--notch-l);
    display: flex; flex-direction: column; align-items: center; text-align: center; padding: 1.5em 1.1em 1.1em; }
