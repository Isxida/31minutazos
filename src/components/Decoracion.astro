---
// Adornos "arcilla y fieltro" para los márgenes en pantallas anchas. Dibujados en SVG (sin imágenes que cargar).
// Solo se ven desde 1200px: en celular no hay márgenes y el centro queda libre.
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <!-- Sombra de arcilla + grano de fieltro -->
    <filter id="clay" x="-20%" y="-20%" width="140%" height="150%">
      <feDropShadow dx="0" dy="7" stdDeviation="5" flood-color="#5a1500" flood-opacity=".35" />
    </filter>
    <filter id="felt" x="0" y="0" width="100%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency=".9" numOctaves="2" seed="4" result="n" />
      <feColorMatrix in="n" type="matrix" values="0 0 0 0 .3  0 0 0 0 .1  0 0 0 0 .05  0 0 0 .22 0" result="g" />
      <feComposite in="g" in2="SourceGraphic" operator="in" result="gi" />
      <feMerge><feMergeNode in="SourceGraphic" /><feMergeNode in="gi" /></feMerge>
    </filter>
  </defs>
</svg>

<aside class="deco deco-l" aria-hidden="true">
  <!-- Televisor CRT antiguo -->
  <svg class="d d1" viewBox="0 0 200 190">
    <g filter="url(#clay)"><g filter="url(#felt)">
      <path d="M100 44L58 8M100 44l44-38" stroke="#fffbe6" stroke-width="5" stroke-linecap="round" />
      <circle cx="58" cy="8" r="6" fill="#ffd23f" /><circle cx="144" cy="6" r="6" fill="#ffd23f" />
      <rect x="40" y="160" width="26" height="14" rx="5" fill="#8a4b2a" /><rect x="134" y="160" width="26" height="14" rx="5" fill="#8a4b2a" />
      <rect x="14" y="40" width="172" height="124" rx="28" fill="#7fdcc8" />
      <rect x="28" y="54" width="108" height="96" rx="26" fill="#2a2030" />
      <rect x="35" y="61" width="94" height="82" rx="22" fill="#cfeaf2" />
      <g opacity=".85"><rect x="41" y="112" width="13" height="26" rx="3" fill="#ff5a5a" /><rect x="55" y="112" width="13" height="26" rx="3" fill="#ffd23f" /><rect x="69" y="112" width="13" height="26" rx="3" fill="#7fdcc8" /><rect x="83" y="112" width="13" height="26" rx="3" fill="#5aa8ff" /><rect x="97" y="112" width="13" height="26" rx="3" fill="#ff9ecb" /><rect x="111" y="112" width="13" height="26" rx="3" fill="#a07cff" /></g>
      <text x="82" y="98" text-anchor="middle" font-family="Anton, sans-serif" font-size="34" fill="#c2001a">31</text>
      <ellipse cx="58" cy="76" rx="20" ry="9" fill="#fff" opacity=".6" transform="rotate(-24 58 76)" />
      <rect x="146" y="56" width="30" height="94" rx="13" fill="#5bbfae" />
      <circle cx="161" cy="80" r="9" fill="#fffbe6" /><circle cx="161" cy="108" r="9" fill="#fffbe6" />
      <path d="M158 80h6M161 77v6M158 108h6" stroke="#5bbfae" stroke-width="2.4" stroke-linecap="round" />
      <path d="M152 126h18M152 133h18M152 140h18" stroke="#2f8f7e" stroke-width="3" stroke-linecap="round" />
      <ellipse cx="60" cy="46" rx="34" ry="5" fill="#fff" opacity=".45" />
    </g></g>
  </svg>
  <!-- Notas adhesivas flotantes -->
  <svg class="d d2" viewBox="0 0 160 140">
    <g filter="url(#clay)"><g filter="url(#felt)">
      <g transform="rotate(-12 50 50)"><rect x="12" y="14" width="68" height="68" rx="9" fill="#ffd23f" /><path d="M24 36h44M24 50h36M24 64h40" stroke="#b8860b" stroke-width="4" stroke-linecap="round" opacity=".55" /><rect x="32" y="8" width="28" height="12" rx="3" fill="#fffbe6" opacity=".8" /></g>
      <g transform="rotate(10 110 60)"><rect x="78" y="34" width="62" height="62" rx="9" fill="#ff9ecb" /><path d="M90 56h38M90 70h28" stroke="#a02060" stroke-width="4" stroke-linecap="round" opacity=".5" /></g>
      <g transform="rotate(-4 60 108)"><rect x="34" y="82" width="58" height="48" rx="9" fill="#7fdcc8" /><path d="M46 102h34M46 114h22" stroke="#117a66" stroke-width="4" stroke-linecap="round" opacity=".55" /></g>
    </g></g>
  </svg>
  <!-- Teléfono rojo de línea fija -->
  <svg class="d d3" viewBox="0 0 200 150">
    <g filter="url(#clay)"><g filter="url(#felt)">
      <rect x="10" y="62" width="180" height="78" rx="28" fill="#d92b2b" />
      <rect x="20" y="28" width="160" height="38" rx="19" fill="#fffbe6" />
      <circle cx="38" cy="46" r="22" fill="#fffbe6" /><circle cx="162" cy="46" r="22" fill="#fffbe6" />
      <circle cx="100" cy="104" r="26" fill="#fffbe6" />
      <g fill="#d92b2b"><circle cx="100" cy="92" r="4" /><circle cx="112" cy="98" r="4" /><circle cx="112" cy="111" r="4" /><circle cx="100" cy="117" r="4" /><circle cx="88" cy="111" r="4" /><circle cx="88" cy="98" r="4" /></g>
      <ellipse cx="60" cy="76" rx="26" ry="7" fill="#fff" opacity=".3" />
      <path d="M14 70q-22 18 0 40" fill="none" stroke="#fffbe6" stroke-width="5" stroke-linecap="round" stroke-dasharray="2 7" />
    </g></g>
  </svg>
</aside>

<aside class="deco deco-r" aria-hidden="true">
  <!-- Cámara de estudio con luz ON AIR -->
  <svg class="d d4" viewBox="0 0 240 230">
    <g filter="url(#clay)"><g filter="url(#felt)">
      <path d="M112 150L64 218M112 150l12 68M112 150l60 66" stroke="#c98a5c" stroke-width="11" stroke-linecap="round" />
      <rect x="68" y="26" width="76" height="42" rx="13" fill="#f6c9a0" />
      <rect x="46" y="58" width="128" height="94" rx="20" fill="#fffbe6" />
      <rect x="156" y="78" width="46" height="54" rx="12" fill="#f6c9a0" />
      <circle cx="206" cy="105" r="28" fill="#4a3b52" /><circle cx="206" cy="105" r="17" fill="#2a2030" />
      <ellipse cx="198" cy="96" rx="8" ry="5" fill="#fff" opacity=".5" transform="rotate(-30 198 96)" />
      <ellipse cx="80" cy="74" rx="26" ry="6" fill="#fff" opacity=".6" />
      <rect x="56" y="166" width="68" height="22" rx="11" fill="#d92b2b" />
      <text x="90" y="182" text-anchor="middle" font-family="Anton, sans-serif" font-size="13" fill="#fffbe6" letter-spacing="1">ON AIR</text>
    </g></g>
    <circle class="tally" cx="64" cy="84" r="20" fill="#ff1a1a" opacity=".45" />
    <circle cx="64" cy="84" r="9" fill="#ff3b30" />
    <circle cx="61" cy="81" r="3" fill="#fff" opacity=".7" />
  </svg>
  <!-- Guitarra acústica -->
  <svg class="d d5" viewBox="0 0 120 280">
    <g filter="url(#clay)"><g filter="url(#felt)">
      <rect x="52" y="40" width="16" height="130" rx="6" fill="#8a4b2a" />
      <rect x="46" y="12" width="28" height="36" rx="9" fill="#6b3a1f" />
      <g fill="#fffbe6"><circle cx="52" cy="22" r="3" /><circle cx="52" cy="34" r="3" /><circle cx="68" cy="22" r="3" /><circle cx="68" cy="34" r="3" /></g>
      <ellipse cx="60" cy="168" rx="34" ry="32" fill="#e58a3a" />
      <ellipse cx="60" cy="214" rx="46" ry="44" fill="#e58a3a" />
      <ellipse cx="46" cy="196" rx="14" ry="30" fill="#fff" opacity=".25" />
      <circle cx="60" cy="190" r="14" fill="#4a2410" />
      <rect x="42" y="232" width="36" height="9" rx="4" fill="#4a2410" />
      <path d="M57 45V234M63 45V234" stroke="#fffbe6" stroke-width="1.4" opacity=".8" />
    </g></g>
  </svg>
  <!-- Libretas de reportero enrolladas -->
  <svg class="d d6" viewBox="0 0 160 120">
    <g filter="url(#clay)"><g filter="url(#felt)">
      <g transform="rotate(-8 80 40)">
        <rect x="20" y="22" width="112" height="46" rx="23" fill="#fffbe6" />
        <circle cx="43" cy="45" r="23" fill="#f6e3b8" />
        <path d="M43 45m-3 0a3 3 0 1 1 6 0a8 8 0 1 1-16 0a13 13 0 1 1 26 0" fill="none" stroke="#c9a561" stroke-width="3" stroke-linecap="round" />
        <rect x="84" y="22" width="14" height="46" fill="#d92b2b" />
        <ellipse cx="86" cy="30" rx="30" ry="5" fill="#fff" opacity=".6" />
      </g>
      <g transform="rotate(6 90 92)">
        <rect x="34" y="74" width="92" height="38" rx="19" fill="#f6c9a0" />
        <circle cx="53" cy="93" r="19" fill="#eab07e" />
        <path d="M53 93m-2 0a2 2 0 1 1 4 0a6 6 0 1 1-12 0a10 10 0 1 1 20 0" fill="none" stroke="#b9703c" stroke-width="3" stroke-linecap="round" />
        <rect x="92" y="74" width="12" height="38" fill="#ffd23f" />
      </g>
    </g></g>
  </svg>
</aside>

<style is:global>
  .deco { display: none; }
  @media (min-width: 1200px) {
    .deco { position: fixed; top: 0; bottom: 0; width: calc((100vw - 860px) / 2); z-index: 0; display: flex; flex-direction: column;
      justify-content: space-around; align-items: center; padding: 4vh 0; pointer-events: none; }
    .deco-l { left: 0; }
    .deco-r { right: 0; }
    .d { width: min(88%, 250px); height: auto; max-height: 28vh; will-change: translate; animation: flota 5s ease-in-out infinite; }
    .d1 { rotate: -8deg; }
    .d2 { rotate: 6deg; animation-delay: -1.5s; }
    .d3 { rotate: -5deg; animation-delay: -3s; }
    .d4 { rotate: 5deg; animation-delay: -2s; }
    .d5 { rotate: 12deg; animation-delay: -.7s; }
    .d6 { rotate: -4deg; animation-delay: -3.6s; }
    .tally { animation: onair 1.6s ease-in-out infinite; }
  }
  @keyframes flota { 50% { translate: 0 -12px; } }
  @keyframes onair { 50% { opacity: .1; } }
  @media (prefers-reduced-motion: reduce) { .d, .tally { animation: none; } }
</style>
